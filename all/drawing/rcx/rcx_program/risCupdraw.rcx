/0LOGBOOK
0

*/
program test {
	
	#include <RCX2.h>
	#include <RCX2MLT.h>
	#include <RCX2Sounds.h>
	#include <RCX2Def.h>
	var lighty = 0
	var light_plus = 0
	sensor light1 on 1
	light1 is light as percent
	event lBrite_light1EventHigh when light1 > 50
	
	
	main {
		ext InterfaceType "kFreestyle"
		rcx_ClearTimers
		bbs_GlobalReset([A B C])
		start LightWatcher0
		rcx_Priority( 8)
		trigger lBrite_light1EventHigh
		try {
			forever {
				display Light1
				on [ A  ] 
			}
		} retry on fail
	}
	
	
	watcher LightWatcher0 monitor lBrite_light1EventHigh
	{
		rcx_Priority( 4 )
		try {
			lighty = (light1*10)
			rcx_Multiply( lighty,100)
			tone (lighty/10) for 30
			reverse [ A  ] 
		} restart on fail
	} restart on event
}
